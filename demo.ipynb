   "id": "524d3493-f2be-488d-a58c-657daa76426e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\"price\": np.random.rand(10000), \"qty\": np.random.rand(10000)})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "8f25b8a9-3fc3-4e5b-a972-c600f33b761a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "unloop: 2016x faster, results identical. Running:\n",
      "df['total'] = df['price'] * df['qty']\n"
     ]
    }
   ],
   "source": [
    "%%unloop\n",
    "for i, row in df.iterrows():\n",
    "    df.at[i, \"total\"] = row[\"price\"] * row[\"qty\"]"
   ]
  },
